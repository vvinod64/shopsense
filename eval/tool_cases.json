{
  "version": "1.0",
  "description": "Labelled calls to every tool of the kartway-orders MCP server (src/shopsense/m6/mcp_server.py). Inputs are rows of data/shopsense/mock_api/*.csv; expected outputs are worked out by hand from those rows and the policy rules in mock_api.py. Cases run in order against one empty action log (writes in later cases see earlier ones). Scored by python -m shopsense.m6.tool_eval; no model calls.",
  "as_of": "2026-10-15",
  "cases": [
    {"id": "T01", "tool": "lookup_order", "args": {"order_ref": "KW-O-000006"},
     "expect": {"order_ref": "KW-O-000006", "customer_ref": "KW-C-00298", "category": "Furniture",
                "product_title": "Magenta When Furniture", "order_value_inr": 2999, "status": "delivered",
                "delivery_promise_days": 7, "actual_delivery_days": 14},
     "why": "orders.csv row KW-O-000006 joined to products.csv KW-SKU-000570 (Furniture)."},
    {"id": "T02", "tool": "lookup_order", "args": {"order_ref": "KW-O-999999"},
     "expect_error": "not found",
     "why": "Unknown order: the tool reports an error instead of inventing an order."},
    {"id": "T03", "tool": "get_customer_account", "args": {"customer_ref": "KW-C-00417"},
     "expect": {"customer_ref": "KW-C-00417", "tier": "plus", "flagged_for_abuse": true},
     "why": "customers.csv KW-C-00417 is one of the 22 accounts flagged for manual review."},
    {"id": "T04", "tool": "track_shipment", "args": {"order_ref": "KW-O-000006"},
     "expect": {"tracking_id": "KW-TRK-0000006", "carrier": "Ecom Express", "last_scan": "exception",
                "last_scan_at": "2026-06-07T05:21", "scan_location": "Nicholsville"},
     "why": "shipments.csv row for KW-O-000006."},
    {"id": "T05", "tool": "check_delivery_sla", "args": {"order_ref": "KW-O-000006"},
     "expect": {"status": "delivered", "promised_days": 7, "actual_days": 14, "days_late": 7, "sla_breach": true},
     "why": "Promised 7 days, delivered in 14: 7 days late."},
    {"id": "T06", "tool": "check_delivery_sla", "args": {"order_ref": "KW-O-000007"},
     "expect": {"status": "shipped", "promised_days": 3, "actual_days": null, "days_late": null},
     "why": "Still shipped: no lateness can be computed yet."},
    {"id": "T07", "tool": "calculate_refund", "args": {"order_ref": "KW-O-000006", "reason_code": "late_delivery"},
     "expect": {"category": "Furniture", "order_value_inr": 2999, "refund_pct": 0.25, "refund_amount_inr": 749.75,
                "goodwill_credits": 300, "eligibility_blockers": [], "auto_approvable": true},
     "why": "Shipping policy §4.2: 4-7 days late = 25% of ₹2,999 = ₹749.75 plus 300 credits; within the ₹2,000 cap."},
    {"id": "T08", "tool": "calculate_refund", "args": {"order_ref": "KW-O-000000", "reason_code": "damaged"},
     "expect": {"category": "Home & Kitchen", "refund_pct": 1.0, "refund_amount_inr": 12999,
                "eligibility_blockers": [], "auto_approvable": false},
     "why": "Damaged = full refund of ₹12,999, which is above the ₹2,000 automated cap."},
    {"id": "T09", "tool": "calculate_refund",
     "args": {"order_ref": "KW-O-000004", "reason_code": "changed_mind", "item_condition": "opened"},
     "expect": {"category": "Sports & Outdoors", "refund_pct": 0.88, "refund_amount_inr": 263.12, "auto_approvable": false},
     "expect_contains": {"eligibility_blockers": "return window closed"},
     "why": "12% opened-item fee on ₹299 = ₹263.12; delivered 2026-07-14, 93 days before as_of, past the 45-day window."},
    {"id": "T10", "tool": "calculate_refund", "args": {"order_ref": "KW-O-000006", "reason_code": "goodwill"},
     "expect_error": "reason_code must be one of",
     "why": "An unknown reason code is rejected, not guessed."},
    {"id": "T11", "tool": "request_refund",
     "args": {"order_ref": "KW-O-000006", "reason_code": "late_delivery", "ticket_id": "EVAL-T11"},
     "expect": {"request_id": "RR-EVAL-T11-KW-O-000006", "amount_inr": 749.75, "status": "auto_approved", "blockers": []},
     "why": "Within the cap, account in good standing, no refund on record: auto-approved; the amount comes from the calculator."},
    {"id": "T12", "tool": "request_refund",
     "args": {"order_ref": "KW-O-000006", "reason_code": "late_delivery", "ticket_id": "EVAL-T11"},
     "expect": {"request_id": "RR-EVAL-T11-KW-O-000006", "amount_inr": 749.75, "status": "auto_approved"},
     "expect_log": {"file": "actions", "request_id": "RR-EVAL-T11-KW-O-000006", "count": 1},
     "why": "Replay of T11: idempotent per (ticket, order), still one record in the action log."},
    {"id": "T13", "tool": "request_refund",
     "args": {"order_ref": "KW-O-000000", "reason_code": "damaged", "ticket_id": "EVAL-T13"},
     "expect": {"amount_inr": 12999, "status": "pending_human_approval"},
     "expect_contains": {"blockers": "above the ₹2,000 automated cap"},
     "why": "₹12,999 is above the ₹2,000 cap: held for a person, never auto-approved."},
    {"id": "T14", "tool": "request_refund",
     "args": {"order_ref": "KW-O-000012", "reason_code": "damaged", "ticket_id": "EVAL-T14"},
     "expect": {"amount_inr": 1499, "status": "pending_human_approval"},
     "expect_contains": {"blockers": "account requires manual review"},
     "why": "₹1,499 is within the cap, but the owner KW-C-00417 is flagged: held."},
    {"id": "T15", "tool": "request_refund",
     "args": {"order_ref": "KW-O-000004", "reason_code": "damaged", "ticket_id": "EVAL-T15"},
     "expect": {"amount_inr": 299, "status": "pending_human_approval"},
     "expect_contains": {"blockers": "already has a refund on record"},
     "why": "refunds.csv already has KW-RF-00125 (processed) for this order: a second refund waits for a person."},
    {"id": "T16", "tool": "request_replacement",
     "args": {"order_ref": "KW-O-000004", "reason_code": "wrong_item", "ticket_id": "EVAL-T16"},
     "expect": {"request_id": "RP-EVAL-T16-KW-O-000004", "status": "auto_approved", "blockers": []},
     "why": "₹299, in stock, account not flagged: replacement auto-approved."},
    {"id": "T17", "tool": "request_replacement",
     "args": {"order_ref": "KW-O-000006", "reason_code": "changed_mind", "ticket_id": "EVAL-T17"},
     "expect_error": "replacements are only for",
     "why": "Replacements are only for damaged, quality or wrong-item orders."},
    {"id": "T18", "tool": "escalate_ticket",
     "args": {"ticket_id": "EVAL-T18", "reason": "refund above cap", "suggested_action": "Team Lead to review ₹12,999 refund"},
     "expect": {"ticket_id": "EVAL-T18", "reason": "refund above cap", "source": "mcp"},
     "expect_log": {"file": "escalations", "ticket_id": "EVAL-T18", "count": 1},
     "why": "Escalation is recorded in the human queue log, tagged as coming over MCP."},
    {"id": "T19", "tool": "lookup_order", "args": {"order_ref": "KW-O-000006"}, "signed_in_customer": "KW-C-00317",
     "expect": {"ownership": "refused"},
     "why": "KW-O-000006 belongs to KW-C-00298, not the signed-in KW-C-00317: the caller's ownership rule (m6/team.py, m5/workflow.py) must refuse it."},
    {"id": "T20", "tool": "lookup_order", "args": {"order_ref": "KW-O-000006"}, "signed_in_customer": "KW-C-00298",
     "expect": {"ownership": "allowed"},
     "why": "The owner asking about their own order is allowed."}
  ]
}
