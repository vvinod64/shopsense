# ShopSense configuration. Copy to .env and fill in; never commit .env.
# Required settings are uncommented. Optional ones are commented out and show their default.

# ---------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------

# Model that runs the system (LiteLLM model string) and its key. GOOGLE_API_KEY also works for Gemini.
LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=

# M3 long-term memory
SUPERMEMORY_API_KEY=

# M3/M4 policy index (Qdrant Cloud)
QDRANT_URL=https://your-cluster-endpoint
QDRANT_API_KEY=

# M7 tracing and M4/M8 scores (EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com,
# JP https://jp.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional. Staff normally sign in on /ui (demo accounts lead, ops, finance; password = username). This is an
# extra fixed reviewer token for scripts calling /tickets/* ("Authorization: Bearer <token>"). The approver must equal the name, and the role
# must cover the amount: team_lead (to ₹10,000), operations_manager (to ₹50,000), finance (above).
# Generate a token:  python -c "import secrets; print(secrets.token_urlsafe(24))"
SHOPSENSE_REVIEW_TOKEN=
SHOPSENSE_REVIEWER_NAME=demo-reviewer
SHOPSENSE_REVIEWER_ROLE=operations_manager

# Customer sign-in (/auth/customer, the /ui page). Tokens are signed with this secret; left empty, one is generated
# in runtime/session_secret. Naming a customer without their token is refused unless login is switched off (dev only).
# SHOPSENSE_SESSION_SECRET=
# SHOPSENSE_REQUIRE_CUSTOMER_LOGIN=true

# ---------------------------------------------------------------------------------------------------------
# Recommended: independent checks from a different provider than LLM_MODEL
# ---------------------------------------------------------------------------------------------------------

# JUDGE_MODEL grades M8 (Ragas, DeepEval, TruLens). REVIEWER_MODEL checks every reply for unsupported
# promises, judges customer messages for injection and gives the M6 fact-checker its second opinion.
# GROQ_API_KEY also enables the Llama Prompt Guard 2 injection classifier.
# Both default to LLM_MODEL; reports record whether the judge is independent.
GROQ_API_KEY=
JUDGE_MODEL=groq/openai/gpt-oss-120b
REVIEWER_MODEL=groq/openai/gpt-oss-120b
# OPENAI_API_KEY=                               # e.g. JUDGE_MODEL=openai/gpt-4o-mini
# ANTHROPIC_API_KEY=                            # e.g. JUDGE_MODEL=anthropic/claude-sonnet-4-5

# ---------------------------------------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------------------------------------

# Models and calls
# SHOPSENSE_LLM_MODEL=                          # overrides LLM_MODEL for one run (free-tier quotas are per model)
# SHOPSENSE_EMBED_MODEL=gemini-embedding-001    # any LiteLLM embedding model; each gets its own Qdrant collection
# LLM_TIMEOUT_SECONDS=60
# LLM_CALL_PAUSE_SECONDS=4                      # spacing between model calls on the free tier (evaluations: 6)

# Model-based checks (always off in tests and --offline runs)
# SHOPSENSE_LLM_COMMITMENT_CHECK=on
# SHOPSENSE_INJECTION_CLASSIFIER=on             # needs GROQ_API_KEY
# SHOPSENSE_INJECTION_MODEL=groq/meta-llama/llama-prompt-guard-2-86m
# SHOPSENSE_INJECTION_THRESHOLD=0.5
# SHOPSENSE_INJECTION_JUDGE=on                  # uses REVIEWER_MODEL when it is a different provider
# SHOPSENSE_REVIEWER_PAUSE_SECONDS=4            # spacing in the live guardrail evaluation
# SHOPSENSE_JUDGE_PAUSE_SECONDS=0               # spacing in the judge audit (8 on a free Groq tier)

# Serving and operations
# SHOPSENSE_ENGINE=team                         # default: /chat runs the M6 multi-agent team; workflow: the M5 workflow (same approval flow)
# SHOPSENSE_AUTOMATION=on                       # paused: tickets are drafted but every action waits for a person
# SHOPSENSE_APPROVAL_TTL_HOURS=72               # held tickets older than this are closed by --expire-overdue
# SHOPSENSE_RUNTIME_DIR=runtime                 # where ledgers, checkpoints, sessions and reports are written
# SHOPSENSE_AS_OF=YYYY-MM-DD                    # fixes "today" for return windows (reproducible runs)
# SHOPSENSE_FAULTS=seed=42,fail=0.2,timeout=0.1,malformed=0.1    # M7 fault injection into the order system

# More reviewers: python -m shopsense.m8.api --add-reviewer NAME ROLE  (tokens stored as hashes)
# SHOPSENSE_REVIEWERS_FILE=runtime/reviewers.json
# Company SSO reviewers (OIDC JWT; name from email or sub, role from the role claim)
# SHOPSENSE_OIDC_ISSUER=
# SHOPSENSE_OIDC_AUDIENCE=
# SHOPSENSE_OIDC_JWKS_URL=                      # default: <issuer>/.well-known/jwks.json
# SHOPSENSE_OIDC_ROLE_CLAIM=shopsense_role

# Tracing
# SHOPSENSE_TRACING=1                           # 0 disables Langfuse tracing
# SHOPSENSE_TRACE_SAMPLE_RATE=1                 # below 1: that share of healthy traces, every failure kept

# Canaries and SLOs (python -m shopsense.m7.canary [--every MINUTES])
# SHOPSENSE_CANARY_IDS=SS-F02,SS-G04,SS-I01
# SHOPSENSE_SLO_PASS_RATE=1.0
# SHOPSENSE_SLO_P95_LATENCY_S=120
# SHOPSENSE_SLO_COST_PER_TICKET_USD=0.01
# SHOPSENSE_SLO_ERROR_RATE=0
# SHOPSENSE_ALERT_WEBHOOK=                      # SLO breaches are posted here (Slack-compatible)
